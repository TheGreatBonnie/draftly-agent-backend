# Database
DATABASE_URL=postgresql://localhost:5432/draftly

# AWS / Amazon Bedrock
AWS_REGION=us-east-1
# AWS credentials via IAM role (EC2/ECS) or:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: Bedrock-specific model overrides
BEDROCK_CLAUDE_REASONING_MODEL=global.anthropic.claude-sonnet-4-6
BEDROCK_CLAUDE_FAST_MODEL=global.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_NOVA_REASONING_MODEL=us.amazon.nova-pro-v1:0
BEDROCK_LLAMA_MODEL=us.meta.llama3-2-90b-instruct-v1:0

# Embedding model
EMBEDDING_MODEL_ID=text-embedding-3-small

# Other providers (optional)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
REQUESTY_API_KEY=
REQUESTY_BASE_URL=
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Amazon Bedrock Mantle (OpenAI-compatible)
MANTLE_API_KEY=
MANTLE_ENDPOINT_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1

# Optional: Mantle-specific model overrides
MANTLE_REASONING_MODEL=openai/gpt-5.6-luna
MANTLE_FAST_MODEL=openai/gpt-oss-120b-1:0