# Database
DATABASE_URL=postgresql://localhost:5432/draftly

# Public origin of the frontend; setup-callback redirects land here.
FRONTEND_URL=http://localhost:3000

# App
APP_URL=http://localhost:8000
REVIEW_DASHBOARD_URL=http://localhost:8000
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# AWS / Amazon Bedrock
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# AWS credentials via IAM role (EC2/ECS) or:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Embedding model
EMBEDDING_MODEL_ID=text-embedding-3-small

# Other providers (optional)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
REQUESTY_API_KEY=
REQUESTY_BASE_URL=
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Amazon Bedrock Mantle
MANTLE_API_KEY=
MANTLE_ENDPOINT_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_OPENAI_ENDPOINT_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1

# Chat routing allowlist (comma-separated). Empty/unset => all providers.
# e.g. DRAFTLY_ENABLED_PROVIDERS=mantle,mantle-openai,orcarouter
DRAFTLY_ENABLED_PROVIDERS=

#MODELS
REQUESTY_LLM_MODEL=tensorx/deepseek-v4-flash
REQUESTY_EMBEDDING_MODEL=azure/openai/text-embedding-3-large@francecentral
REQUESTY_DEEPSEEK_V4_PRO_MODEL=deepseek/deepseek-v4-pro-0813
REQUESTY_DEEPSEEK_V4_FLASH_MODEL=deepseek/deepseek-v4-flash-0731
REQUESTY_DEEPSEEK_REASONING_MODEL=deepseek/deepseek-reasoner
REQUESTY_OPENAI_5.6_LUNA_MODEL=openai/gpt-5.6-luna
REQUESTY_EMBEDDING_MODEL_ID=text-embedding-3-small
ORCA_DEEPSEEK_V4_PRO_MODEL=deepseek/deepseek-v4-pro
ORCA_DEEPSEEK_V4_FLASH_MODEL=deepseek/deepseek-v4-flash
ORCA_DEEPSEEK_V4_PRO_FREE_MODEL=deepseek/deepseek-v4-pro-free
ORCA_DEEPSEEK_V4_FLASH_FREE_MODEL=deepseek/deepseek-v4-flash-free
ORCA_DEEPSEEK_REASONING_MODEL=deepseek/deepseek-reasoner
ORCA_OPENAI_EMBEDDING_MODEL_SMALL=openai/text-embedding-3-small
ORCA_OPENAI_EMBEDDING_MODEL_LARGE=openai/text-embedding-3-large
ORCA_OPENAI_5.6_LUNA_MODEL=openai/gpt-5.6-luna
ORCA_DEEPSEEK_V4_FLASH_0731_MODEL=deepseek/deepseek-v4-flash-0731
NVIDIA_GLM_5.2_MODEL=z-ai/glm-5.2
NVIDIA_DEEPSEEK_V4_PRO_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_DEEPSEEK_V4_FLASH_MODEL=deepseek-ai/deepseek-v4-flash
MINIMAX_M3_MODEL=minimax-ai/minimax-m3
NVIDIA_KIMI_K2.6_MODEL=moonshotai/kimi-k2.6
NVIDIA_EMBEDDING_MODEL=nemotron-3-embed-1b
NVIDIA_KIMI_K3_MODEL=moonshotai/kimi-k3
NEMOTRON_3_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LAGUNA_MODEL=poolside/laguna-s-2.1:free

# Default model routing (used when provider-specific models are not set)
# These are configured in src/draftly/app/config.py

# MiniMax API Key
MINIMAX_API_KEY=

# Per-stage LLM models (all routed through Requesty)
RESEARCH_MODEL=tensorx/deepseek-v4-flash
REVIEW_MODEL=tensorx/deepseek-v4-flash
RUBRIC_GRADER_MODEL=tensorx/deepseek-v4-flash
RUBRIC_MAX_ITERATIONS=3

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/slack/oauth/callback

# Discord
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_APP_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=

# Clerk (auth + organizations)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGNING_SECRET=

# Sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Redis / event streaming
EVENTS_STREAMING_ENABLED=true
REDIS_URL=redis://localhost:6379
RQ_ENABLED=true
VECTOR_SEARCH_BACKEND=pgvector
SEMANTIC_CACHE_ENABLED=false

# Agent steering (spec: 2026-09-10-agent-steering-design)
# Master switch (records decisions, no blocking). Enforcement blocks/guides
# per the role policy matrix. LLM judge refines safe decisions only.
STRANDS_STEERING_ENABLED=true
STRANDS_STEERING_ENFORCEMENT_ENABLED=false
STRANDS_STEERING_POLICY_VERSION=v1
STRANDS_STEERING_LLM_ENABLED=false
STRANDS_STEERING_TOOL_GUIDES_PER_CALL=2
STRANDS_STEERING_MODEL_GUIDES_PER_TURN=2
STRANDS_STEERING_TOTAL_GUIDES_PER_AGENT=5
STRANDS_STEERING_JUDGE_TIMEOUT_SECONDS=10.0
# Timeout budgets (s). Large-PR impact runs outrun the 600s default per-node
# writer budget, so node headroom covers a whole multi-revision writer.
STRANDS_NODE_TIMEOUT=5400
STRANDS_EXECUTION_TIMEOUT=3600

# Worker cost/performance rollout flags (spec: 2026-09-13-worker-performance-cost)
# Every flag defaults to off. draftly_fastpath is the composite that flips the
# five flags it owns; the rest stay independently controllable.
STRANDS_SILENT_AGENT_CALLBACKS=true
STRANDS_SELECTIVE_STEERING_JUDGE=true
STRANDS_CAPABILITY_AWARE_RESEARCH=true
STRANDS_STRUCTURED_EVALUATION_REQUIREMENTS=true
STRANDS_TARGETED_DRAFT_REVISIONS=true
STRANDS_BATCH_DRAFT_TOOLS=true
STRANDS_RUN_COST_SUMMARY=true
STRANDS_PROVIDER_WARMUP=true
STRANDS_WRITER_MIDDLE_TIER=true
STRANDS_STEERING_JUDGE_CALLS_PER_STAGE=3
# Composite: turns on selective_steering_judge, capability_aware_research,
# batch_draft_tools, provider_warmup, writer_middle_tier in one shot.
DRAFTLY_FASTPATH=true